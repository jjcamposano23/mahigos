rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function allowed() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          'jjcamposano23@gmail.com',
          'upiaaosec@gmail.com',
          'gbbrutas@up.edu.ph',
          'ivmancenido@up.edu.ph'
        ];
    }

    // Each member manages their own avatar under avatars/{uid}/…
    match /avatars/{uid}/{file=**} {
      allow read: if allowed();
      allow write: if allowed()
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Voice / video message clips under clips/{uid}/…
    match /clips/{uid}/{file=**} {
      allow read: if allowed();
      allow write: if allowed()
        && request.auth.uid == uid
        && request.resource.size < 25 * 1024 * 1024;
    }

    // Document library uploads under library/{uid}/…
    match /library/{uid}/{file=**} {
      allow read: if allowed();
      allow write: if allowed()
        && request.auth.uid == uid
        && request.resource.size < 25 * 1024 * 1024;
    }

    // Images dropped onto a whiteboard under whiteboards/{boardId}/…
    match /whiteboards/{boardId}/{file=**} {
      allow read: if allowed();
      allow write: if allowed()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{all=**} {
      allow read, write: if false;
    }
  }
}

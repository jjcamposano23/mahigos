rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only these authorized UP Ibalon accounts may access any data.
    function allowedEmails() {
      return [
        'jjcamposano23@gmail.com',
        'upiaaosec@gmail.com',
        'gbbrutas@up.edu.ph',
        'ivmancenido@up.edu.ph'
      ];
    }

    function isAllowed() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in allowedEmails();
    }

    function isAdmin() {
      return isAllowed()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User profiles
    match /users/{uid} {
      allow read: if isAllowed();
      allow create: if isAllowed() && request.auth.uid == uid;
      allow update, delete: if isAllowed() && (request.auth.uid == uid || isAdmin());
    }

    // Shared task board
    match /tasks/{taskId} {
      allow read, create, update, delete: if isAllowed();
    }

    // Shared calendar events
    match /events/{eventId} {
      allow read, create, update, delete: if isAllowed();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

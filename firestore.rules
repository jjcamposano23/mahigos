rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User profiles: anyone signed in can read the roster;
    // a user may write their own profile; admins may write anyone's.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update, delete: if request.auth.uid == uid || isAdmin();
    }

    // Tasks: shared workspace board for all signed-in members.
    match /tasks/{taskId} {
      allow read, create, update: if signedIn();
      allow delete: if signedIn();
    }

    // Default deny for everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only these authorized UP Ibalon accounts may access any data.
    function allowedEmails() {
      return [
        'jjcamposano23@gmail.com',
        'upiaaosec@gmail.com',
        'gbbrutas@up.edu.ph',
        'ivmancenido@up.edu.ph'
      ];
    }

    function isAllowed() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in allowedEmails();
    }

    function isAdmin() {
      return isAllowed()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User profiles
    match /users/{uid} {
      allow read: if isAllowed();
      allow create: if isAllowed() && request.auth.uid == uid;
      allow update, delete: if isAllowed() && (request.auth.uid == uid || isAdmin());
    }

    // Shared task board + per-task review comments
    match /tasks/{taskId} {
      allow read, create, update, delete: if isAllowed();
      match /{sub}/{subId} {
        allow read, create, update, delete: if isAllowed();
      }
    }

    // Projects / boards
    match /projects/{projectId} {
      allow read, create, update, delete: if isAllowed();
    }

    // Channels + direct messages, with their message subcollection
    match /channels/{channelId} {
      allow read, create, update, delete: if isAllowed();
      match /messages/{messageId} {
        allow read, create, update, delete: if isAllowed();
      }
    }

    // Collaborative documents + versions / comments / presence
    match /documents/{docId} {
      allow read, create, update, delete: if isAllowed();
      match /{sub}/{subId} {
        allow read, create, update, delete: if isAllowed();
      }
    }

    // Whiteboards + notes / cursors
    match /whiteboards/{boardId} {
      allow read, create, update, delete: if isAllowed();
      match /{sub}/{subId} {
        allow read, create, update, delete: if isAllowed();
      }
    }

    // Native calls: participants + WebRTC signaling subcollections
    match /calls/{callId} {
      allow read, create, update, delete: if isAllowed();
      match /{sub}/{subId} {
        allow read, create, update, delete: if isAllowed();
      }
    }

    // Zoom meetings — created/edited only by Cloud Functions (Admin SDK);
    // clients read the list and act through callable functions.
    match /meetings/{meetingId} {
      allow read: if isAllowed();
      allow write: if false;
    }

    // Per-user notifications. Anyone allowlisted may create one (e.g. to
    // @mention a teammate); recipients read/update/delete their own.
    match /notifications/{noteId} {
      allow create: if isAllowed();
      allow read, update, delete: if isAllowed() && resource.data.toUid == request.auth.uid;
    }

    // Shared calendar events
    match /events/{eventId} {
      allow read, create, update, delete: if isAllowed();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
